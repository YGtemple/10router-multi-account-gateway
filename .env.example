# 10Router 面板密码（用于 /api/auth/login）
ROUTER_PASSWORD=your-panel-password

# 10Router 地址（默认 http://127.0.0.1:20128）
ROUTER_BASE=http://127.0.0.1:20128

# 临期窗口天数（默认 7）
EXPIRING_DAYS=7

# 调度器重排间隔（分钟，默认 10）
INTERVAL_MIN=10

# 倍率表所在目录（默认脚本所在目录）
# RATES_DIR=/path/to/rates

# Trae 在 10Router 里的 provider id（sync-trae-quota.mjs 用）
# 通过 GET /api/providers 查看 connections[].provider
# TRAE_PROVIDER_ID=openai-compatible-chat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
